<?xml version="1.0" ?>
<package format="3">
  <name>agilex_ranger_mini_sim</name>
  <version>0.1.0</version>
  <description>
    MoveIt Pro MuJoCo simulation of the AgileX Ranger Mini v3 in the suite_106
    room. Inherits the robot and Nav2 setup from agilex_ranger_mini_mock.
  </description>

  <maintainer email="support@picknik.ai">MoveIt Pro Maintainer</maintainer>

  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>agilex_ranger_mini_mock</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>picknik_mujoco_ros</exec_depend>

  <test_depend>agilex_ranger_mini_mock</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-pil</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
