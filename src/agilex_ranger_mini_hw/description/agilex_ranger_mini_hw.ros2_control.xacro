<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find agilex_ranger_mini_mock)/description/agilex_ranger_mini_ros2_control_joints.xacro" />

  <!--
    @brief Physical hardware: ros2_control over topics, bridged to the AgileX driver.

    @details The Ranger's firmware takes only a body twist over CAN, through
    AgileX's ranger_base driver. This block publishes the planar joint velocity
    commands as a JointState, and reads the joint states back from a topic.
    scripts/ranger_driver_bridge.py converts both ways against the driver.

    The command topic carries every joint name but only the commanded values,
    in joint order. The planar joints come first, so the bridge pairs them.
    A negative threshold publishes every cycle, so the bridge's watchdog only
    fires when the controller manager stops.

    @param name Name of the ros2_control block.
    @param initial_positions Unused: the driver's odometry sets the pose.
  -->
  <xacro:macro name="agilex_ranger_mini_ros2_control" params="name initial_positions">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>joint_state_topic_hardware_interface/JointStateTopicSystem</plugin>
        <param name="joint_commands_topic">/agilex_ranger_mini/joint_commands</param>
        <param name="joint_states_topic">/agilex_ranger_mini/joint_states</param>
        <param name="trigger_joint_command_threshold">-1</param>
      </hardware>
      <xacro:agilex_ranger_mini_ros2_control_joints initial_positions="${initial_positions}" />
    </ros2_control>
  </xacro:macro>
</robot>
