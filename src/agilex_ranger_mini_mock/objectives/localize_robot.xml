<?xml version="1.0" encoding="UTF-8" ?>
<root BTCPP_format="4" main_tree_to_execute="Localize Robot">
  <BehaviorTree
    ID="Localize Robot"
    _description="Place a marker where the base really is, refine AMCL without moving, and accept only a pose that fits the lidar scan. On rejection, re-publish the previous estimate. Keep the base stationary; after cancelling, run localization again."
    _favorite="true"
  >
    <Control ID="Sequence">
      <!--The marker starts above the base so it is visible; its height is ignored.-->
      <Action
        ID="GetLatestTransform"
        target_frame_id="map"
        source_frame_id="base_link"
        transform="{base_in_map}"
      />
      <Action
        ID="ConvertTransformStampedToPoseStamped"
        transform_stamped="{base_in_map}"
        pose_stamped="{base_pose}"
      />
      <Action
        ID="TransformPose"
        input_pose="{base_pose}"
        translation_xyz="0;0;1.0"
        output_pose="{marker_seed_pose}"
      />
      <Action ID="ResetVector" vector="{marker_poses}" />
      <Action
        ID="PushBackVector"
        input_vector="{marker_poses}"
        element="{marker_seed_pose}"
        output_vector="{marker_poses}"
      />
      <Action
        ID="AdjustPoseWithIMarker"
        prompts="Move the marker over where the base really is, X axis forward. Height is ignored. Keep the base stationary until this Objective finishes."
        initial_poses="{marker_poses}"
        adjusted_poses="{adjusted_poses}"
      />
      <Action
        ID="GetElementOfVector"
        vector_in="{adjusted_poses}"
        index="0"
        element="{initial_pose}"
      />
      <Action
        ID="TransformPoseFrame"
        name="TransformPoseFrame"
        output_pose="{initial_pose}"
        target_frame_id="map"
        input_pose="{initial_pose}"
      />
      <Action
        ID="GetLatestTransform"
        name="Remember the previous estimate"
        target_frame_id="map"
        source_frame_id="base_link"
        transform="{restore_transform}"
      />
      <Action
        ID="ConvertTransformStampedToPoseStamped"
        transform_stamped="{restore_transform}"
        pose_stamped="{restore_pose}"
      />
      <SubTree
        ID="Refine Localization In Place Subtree"
        seed_pose="{initial_pose}"
        restore_pose="{restore_pose}"
      />
    </Control>
  </BehaviorTree>
  <TreeNodesModel>
    <SubTree ID="Localize Robot">
      <MetadataFields>
        <Metadata runnable="true" />
        <Metadata subcategory="Navigation" />
      </MetadataFields>
    </SubTree>
  </TreeNodesModel>
</root>
