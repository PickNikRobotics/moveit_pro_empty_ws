<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    @brief The Ranger Mini's <joint> entries for a <ros2_control> block.

    @details Joints only, with no block and no plugin, so mock, sim and hw
    share one joint vocabulary. The planar joints come first: the hw topic
    interface lists command values in joint order, and its bridge relies on it.

    | Joints                 | Command  | State              |
    | - | - | - |
    | three planar base axes | velocity | position, velocity |
    | four steering joints   | none     | position, velocity |
    | four wheel joints      | none     | position, velocity |

    @param initial_positions Dict with the boot value of each planar joint.
  -->
  <xacro:macro name="agilex_ranger_mini_ros2_control_joints" params="initial_positions">
    <xacro:macro name="agilex_ranger_mini_planar_joint" params="joint_name">
      <joint name="${joint_name}">
        <command_interface name="velocity" />
        <state_interface name="position">
          <param name="initial_value">${initial_positions[joint_name]}</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </xacro:macro>

    <xacro:macro name="agilex_ranger_mini_state_joint" params="joint_name">
      <joint name="${joint_name}">
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </xacro:macro>

    <xacro:agilex_ranger_mini_planar_joint joint_name="linear_x_joint" />
    <xacro:agilex_ranger_mini_planar_joint joint_name="linear_y_joint" />
    <xacro:agilex_ranger_mini_planar_joint joint_name="rotational_yaw_joint" />

    <xacro:agilex_ranger_mini_state_joint joint_name="fl_steering_joint" />
    <xacro:agilex_ranger_mini_state_joint joint_name="fr_steering_joint" />
    <xacro:agilex_ranger_mini_state_joint joint_name="rl_steering_joint" />
    <xacro:agilex_ranger_mini_state_joint joint_name="rr_steering_joint" />

    <xacro:agilex_ranger_mini_state_joint joint_name="fl_wheel_joint" />
    <xacro:agilex_ranger_mini_state_joint joint_name="fr_wheel_joint" />
    <xacro:agilex_ranger_mini_state_joint joint_name="rl_wheel_joint" />
    <xacro:agilex_ranger_mini_state_joint joint_name="rr_wheel_joint" />
  </xacro:macro>
</robot>
