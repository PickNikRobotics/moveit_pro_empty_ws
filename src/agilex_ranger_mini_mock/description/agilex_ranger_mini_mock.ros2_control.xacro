<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find agilex_ranger_mini_mock)/description/agilex_ranger_mini_ros2_control_joints.xacro" />

  <!--
    @brief Mock hardware: ros2_control's GenericSystem.

    @details calculate_dynamics integrates each planar velocity command into
    its position state, so the mock base moves when driven. The steering and
    wheel joints hold their initial values.

    Every mode's hardware file defines this macro with the same signature;
    config.yaml selects the file through the hardware_xacro urdf_param.

    @param name Name of the ros2_control block.
    @param initial_positions Dict with the boot value of each planar joint.
  -->
  <xacro:macro name="agilex_ranger_mini_ros2_control" params="name initial_positions">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="calculate_dynamics">true</param>
      </hardware>
      <xacro:agilex_ranger_mini_ros2_control_joints initial_positions="${initial_positions}" />
    </ros2_control>
  </xacro:macro>
</robot>
